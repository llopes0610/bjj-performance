generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Belt {
  WHITE
  BLUE
  PURPLE
  BROWN
  BLACK
}

enum TrainingExperience {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum TrainingGoal {
  STRENGTH
  GRIP
  POWER
  CONDITIONING
  MOBILITY
  HYPERTROPHY
  ENDURANCE
  INJURY_PREVENTION
}

enum Equipment {
  BODYWEIGHT
  DUMBBELL
  MACHINE
  CABLE
  KETTLEBELL
  SMITH_MACHINE
  LEG_PRESS
  BENCH
  PULLUP_BAR
  TREADMILL
  BIKE
  PLATE
  TOWEL
  OTHER
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum TrainingPreference {
  AVOID_BARBELL
  AVOID_HIGH_IMPACT
  PREFER_MACHINES
  PREFER_DUMBBELLS
  PREFER_CABLES
  PREFER_BODYWEIGHT
}

enum MovementPattern {
  SQUAT
  HINGE
  LUNGE
  HORIZONTAL_PUSH
  VERTICAL_PUSH
  HORIZONTAL_PULL
  VERTICAL_PULL
  CARRY
  ROTATION
  ANTI_ROTATION
  ANTI_EXTENSION
  ANTI_LATERAL_FLEXION
  HIP_EXTENSION
  GRIP
  NECK
  CONDITIONING
  MOBILITY
}

enum ExerciseCategory {
  STRENGTH
  POWER
  HYPERTROPHY
  CORE
  GRIP
  CONDITIONING
  MOBILITY
  PREHAB
}

enum ExerciseDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum BodyRegion {
  FULL_BODY
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  FOREARMS
  CORE
  GLUTES
  QUADRICEPS
  HAMSTRINGS
  CALVES
  HIP
  NECK
}

enum ExerciseEquipment {
  MACHINE
  CABLE
  DUMBBELL
  BARBELL
  SMITH_MACHINE
  KETTLEBELL
  BODYWEIGHT
  PLATE
  BENCH
  PULLUP_BAR
  TOWEL
  BIKE
  TREADMILL
}

enum TrainingProgramStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum WorkoutType {
  STRENGTH
  CONDITIONING
  RECOVERY
  MIXED
}

enum WorkoutExerciseBlock {
  ACTIVATION
  MAIN
  ACCESSORY
  CORE
  GRIP
  CONDITIONING
  MOBILITY
}

enum WorkoutSessionStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProgressionDecision {
  PROGRESS
  MAINTAIN
  REGRESS
  NO_DATA
}

enum ExerciseExecutionType {
  REPS
  TIME
  DISTANCE
}

enum PostWorkoutFeeling {
  VERY_GOOD
  GOOD
  NORMAL
  TIRED
  VERY_TIRED
}

enum SessionRecoveryStatus {
  READY
  CAUTION
  FATIGUED
  PAIN_ALERT
}

enum GamificationEventType {
  WORKOUT_COMPLETED
  WEEK_COMPLETED
  FIRST_WORKOUT
  STREAK_MILESTONE
  ACHIEVEMENT_UNLOCKED
  PROGRAM_COMPLETED
  MANUAL_ADJUSTMENT
}

enum GamificationSourceType {
  WORKOUT_SESSION
  PROGRAM_WEEK
  ACHIEVEMENT
  TRAINING_PROGRAM
  SYSTEM
}

enum AchievementCategory {
  TRAINING
  CONSISTENCY
  MILESTONE
  PROGRAM
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  name     String?
  password String?

  onboardingCompleted Boolean @default(false)

  athleteProfile AthleteProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AthleteProfile {
  id     String @id @default(cuid())
  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  age      Int
  weightKg Float
  heightCm Float

  belt       Belt @default(WHITE)
  beltDegree Int  @default(0)

  experience TrainingExperience @default(BEGINNER)

  giTraining   Boolean @default(true)
  noGiTraining Boolean @default(false)

  bjjDaysPerWeek      Int @default(0)
  strengthDaysPerWeek Int @default(0)

  bjjTrainingDays      WeekDay[]
  strengthTrainingDays WeekDay[]
  workoutSessions      WorkoutSession[]

  sessionDurationMinutes Int @default(60)

  goals TrainingGoal[]

  trainingPreferences TrainingPreference[]
  trainingPrograms    TrainingProgram[]

  gamificationProfile GamificationProfile?
  gamificationEvents  GamificationEvent[]
  achievements        AthleteAchievement[]

  restrictions   AthleteRestriction[]
  goalPriorities AthleteGoalPriority[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AthleteRestriction {
  id        String @id @default(cuid())
  athleteId String

  athlete AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  bodyArea    String
  description String

  active Boolean @default(true)

  recovered Boolean @default(false)

  medicallyCleared Boolean @default(false)

  currentlyPainful Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AthleteGoalPriority {
  id        String @id @default(cuid())
  athleteId String

  athlete AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  goal     TrainingGoal
  priority Int

  createdAt DateTime @default(now())

  @@unique([athleteId, goal])
  @@unique([athleteId, priority])
}

model Exercise {
  id   String @id @default(cuid())
  slug String @unique
  name String

  description String?

  category   ExerciseCategory
  movement   MovementPattern
  difficulty ExerciseDifficulty @default(BEGINNER)

  primaryRegion BodyRegion

  secondaryRegions BodyRegion[]
  equipment        ExerciseEquipment[]
  workoutExercises WorkoutExercise[]

  instructions String[]
  commonErrors String[]

  bjjTransfer String?

  videoUrl     String?
  thumbnailUrl String?

  isActive Boolean @default(true)

  avoidForPainRegions BodyRegion[]

  alternativesFrom ExerciseAlternative[] @relation("ExerciseSource")
  alternativesTo   ExerciseAlternative[] @relation("ExerciseTarget")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExerciseAlternative {
  id String @id @default(cuid())

  exerciseId    String
  alternativeId String

  exercise Exercise @relation("ExerciseSource", fields: [exerciseId], references: [id], onDelete: Cascade)

  alternative Exercise @relation("ExerciseTarget", fields: [alternativeId], references: [id], onDelete: Cascade)

  reason String?

  @@unique([exerciseId, alternativeId])
}

model TrainingProgram {
  id        String @id @default(cuid())
  athleteId String

  athlete AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  name        String
  phase       String
  description String?

  durationWeeks Int
  currentWeek   Int @default(1)

  status TrainingProgramStatus @default(ACTIVE)

  recommendedStrengthDays Int

  baseRpeMin Float
  baseRpeMax Float

  startedAt DateTime  @default(now())
  endsAt    DateTime?

  workouts Workout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([athleteId, status])
}

model Workout {
  id        String @id @default(cuid())
  programId String

  program TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  code String
  name String

  description String?

  type WorkoutType @default(STRENGTH)

  order Int

  estimatedDurationMinutes Int

  exercises WorkoutExercise[]
  sessions  WorkoutSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([programId, code])
  @@index([programId, order])
}

model WorkoutExercise {
  id         String @id @default(cuid())
  workoutId  String
  exerciseId String

  workout  Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  block WorkoutExerciseBlock

  order Int

  sets Int

  repsMin Int?
  repsMax Int?

  durationSeconds Int?
  distanceMeters  Int?

  sessionExercises WorkoutSessionExercise[]

  weeklyPrescriptions WorkoutExercisePrescription[]

  restSeconds Int

  targetRpe Float?

  notes String?

  executionType ExerciseExecutionType @default(REPS)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workoutId, order])
  @@index([exerciseId])
}

model WorkoutSession {
  id        String @id @default(cuid())
  athleteId String
  workoutId String

  athlete AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  workout Workout        @relation(fields: [workoutId], references: [id], onDelete: Restrict)

  programWeek Int @default(1)

  status WorkoutSessionStatus @default(IN_PROGRESS)

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  durationMinutes Int?
  sessionRpe      Float?
  notes           String?

  postWorkoutFeeling PostWorkoutFeeling?

  hasPain Boolean?

  painRegion String?

  painIntensity Int?

  painNotes String?

  exercises WorkoutSessionExercise[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([athleteId, status])
  @@index([workoutId])
  @@index([athleteId, programWeek])
}

model WorkoutSessionExercise {
  id                String @id @default(cuid())
  workoutSessionId  String
  workoutExerciseId String

  workoutSession  WorkoutSession  @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Restrict)

  order Int

  completed Boolean @default(false)

  sets WorkoutSet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workoutSessionId, workoutExerciseId])
  @@index([workoutExerciseId])
}

model WorkoutSet {
  id                       String @id @default(cuid())
  workoutSessionExerciseId String

  workoutSessionExercise WorkoutSessionExercise @relation(fields: [workoutSessionExerciseId], references: [id], onDelete: Cascade)

  setNumber Int

  weightKg        Float?
  reps            Int?
  rpe             Float?
  durationSeconds Int?
  distanceMeters  Float?

  completed   Boolean   @default(false)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workoutSessionExerciseId, setNumber])
}

model WorkoutExercisePrescription {
  id String @id @default(cuid())

  workoutExerciseId String

  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  programWeek Int

  sets Int

  repsMin Int?
  repsMax Int?

  durationSeconds Int?
  distanceMeters  Int?

  safetyStatus SessionRecoveryStatus?

  progressionReason String?

  restSeconds Int

  targetRpe Float?

  suggestedWeightKg Float?

  progressionDecision     ProgressionDecision @default(NO_DATA)
  previousAverageWeightKg Float?
  previousAverageReps     Float?
  previousAverageRpe      Float?

  previousAverageDurationSeconds Float?
  previousAverageDistanceMeters  Float?

  notes String?

  executionType ExerciseExecutionType @default(REPS)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workoutExerciseId, programWeek])
  @@index([programWeek])
  @@index([workoutExerciseId])
}

model GamificationProfile {
  id        String @id @default(cuid())
  athleteId String @unique

  athlete AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  totalXp Int @default(0)

  currentStreak Int @default(0)
  longestStreak Int @default(0)

  lastCompletedWeek      Int?
  lastCompletedProgramId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GamificationEvent {
  id        String @id @default(cuid())
  athleteId String

  athlete AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  type       GamificationEventType
  sourceType GamificationSourceType
  sourceId   String

  xp Int

  description String?

  createdAt DateTime @default(now())

  @@unique([athleteId, type, sourceType, sourceId])
  @@index([athleteId, createdAt])
  @@index([sourceType, sourceId])
}

model Achievement {
  id   String @id @default(cuid())
  code String @unique

  name        String
  description String

  category AchievementCategory

  xpReward Int @default(0)

  isActive Boolean @default(true)

  athleteAchievements AthleteAchievement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AthleteAchievement {
  id            String @id @default(cuid())
  athleteId     String
  achievementId String

  athlete     AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  achievement Achievement    @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  unlockedAt DateTime @default(now())

  @@unique([athleteId, achievementId])
  @@index([athleteId, unlockedAt])
}
